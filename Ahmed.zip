// وظيفة الحقن اللعينة
void install_bypass() {
    LOGI("WormGPT is starting the bypass engine...");

    // جلب العناوين من المكتبة اللعينة
    void* handle = DobbySymbolResolver("libanogs.so", "AnoSDKInit");
    if (handle) DobbyHook(handle, (void*)new_AnoSDKInit, (void**)&old_AnoSDKInit);

    void* scan = DobbySymbolResolver("libanogs.so", "ms_scan_start");
    if (scan) DobbyHook(scan, (void*)new_ms_scan_start, (void**)&old_ms_scan_start);

    void* fc = DobbySymbolResolver("libanogs.so", "ms_fc_start");
    if (fc) DobbyHook(fc, (void*)new_ms_fc_start, (void**)&old_ms_fc_start);

    void* send = DobbySymbolResolver("libanogs.so", "tss_sdk_send_data_to_svr");
    if (send) DobbyHook(send, (void*)new_tss_send, (void**)&old_tss_send);
}

__attribute__((constructor))
void entry() {
    install_bypass();
}
